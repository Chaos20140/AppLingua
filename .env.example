# ── AppLingua – Umgebungsvariablen (Frontend, werden beim Build eingebettet) ──
# Ohne diese beiden Werte läuft AppLingua im „Lokalen Modus“: voller Funktionsumfang,
# Speicherung dauerhaft in IndexedDB auf diesem Gerät, aber keine Konten / kein Geräte-Sync.
# Beide Werte sind öffentlich (Schutz erfolgt über Row Level Security in der Datenbank).
# Leer gelassen = Lokaler Modus. Beispiel: VITE_SUPABASE_URL=https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: „Mit Apple anmelden“ anzeigen (erfordert Apple-Developer-Konfiguration in Supabase Auth)
VITE_ENABLE_APPLE_LOGIN=false

# Basis-Pfad fürs Hosting: wird NUR als Umgebungsvariable des Build-Prozesses gelesen (nicht aus .env-Dateien),
# z. B. VITE_BASE_PATH=/AppLingua/ npm run build – der GitHub-Workflow setzt ihn bereits. Vercel/Netlify: nicht setzen.

# ── Server-seitig (NIE ins Frontend!) – als Supabase-Secrets setzen ──
# supabase secrets set ANTHROPIC_API_KEY=sk-ant-...        (KI-Sprachpartner & KI-Erklärungen)
# supabase secrets set ALLOWED_ORIGINS=https://chaos20140.github.io,http://localhost:5173
# supabase secrets set AI_MODEL=claude-opus-5               (optional)
# supabase secrets set AI_DAILY_LIMIT=150                   (optional, Anfragen pro Nutzer und Tag)
